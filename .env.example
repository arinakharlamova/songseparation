# Music Separation Service Configuration

# Model settings
MUSIC_SEP_MODEL_NAME=htdemucs
MUSIC_SEP_DEVICE=cuda

# Audio settings
MUSIC_SEP_MAX_FILE_SIZE_MB=50
MUSIC_SEP_MAX_DURATION_MINUTES=10
MUSIC_SEP_SAMPLE_RATE=44100

# API settings
MUSIC_SEP_API_HOST=0.0.0.0
MUSIC_SEP_API_PORT=8000

# Paths
MUSIC_SEP_CACHE_DIR=./cache
MUSIC_SEP_MODEL_CACHE_DIR=./models
MUSIC_SEP_UPLOAD_DIR=./uploads
MUSIC_SEP_OUTPUT_DIR=./outputs
